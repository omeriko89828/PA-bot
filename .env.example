# Copy this file to ".env" and fill in the real values.
# ".env" is gitignored so your secrets never get committed.

# From @BotFather in Telegram (see README, Phase 1)
TELEGRAM_BOT_TOKEN=put-your-token-here

# From https://aistudio.google.com  ->  "Get API key" (see README, Phase 2)
GEMINI_API_KEY=put-your-key-here
