# Copy this file to ".env" and fill in the real values.
# ".env" is gitignored so your secrets never get committed.

# From @BotFather in Telegram (see README, Phase 1)
TELEGRAM_BOT_TOKEN=put-your-token-here

# From https://aistudio.google.com  ->  "Get API key" (see README, Phase 2)
GEMINI_API_KEY=put-your-key-here

# iCloud calendar (optional). App-specific password from appleid.apple.com ->
# Sign-In and Security -> App-Specific Passwords. Leave unset to skip iCloud.
ICLOUD_USERNAME=your-apple-id@example.com
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop
# ICLOUD_CALENDAR=Home        # optional: exact calendar name; default is the first

# Optional overrides
# BRIEFING_TIME=08:00
# BRIEFING_TZ=Asia/Jerusalem
